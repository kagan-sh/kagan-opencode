{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": [
      "bun"
    ],
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src",
    "test",
    "scripts"
  ]
}
