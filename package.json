{
  "name": "@kagan-sh/kagan",
  "version": "0.0.0-development",
  "description": "Makes opencode self-extensible: an agent writes, checks and proposes extensions; a person approves them before they run.",
  "keywords": [
    "opencode",
    "plugin",
    "extensions"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagan-sh/kagan-opencode.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "shims",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "e2e": "bun scripts/e2e.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "@opentui/solid": "0.9.8",
    "@types/bun": "1.3.14",
    "solid-js": "1.9.17"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
